def assert_schema(df, schema, *, name: str, mode: str) -> None:
    actual = df.schema
    actual_names = set(actual.fieldNames())
    expected_names = {field.name for field in schema}
    missing = expected_names - actual_names
    if missing:
        names = ", ".join(sorted(missing))
        raise ValueError(f"{name} is missing required column(s): {names}")
    if mode == "strict":
        extra = actual_names - expected_names
        if extra:
            names = ", ".join(sorted(extra))
            raise ValueError(f"{name} has unexpected column(s): {names}")
    for expected in schema:
        actual_field = actual[expected.name]
        _validate_runtime_metadata(actual_field, expected, path=f"{name}.{expected.name}")
        if not _same_data_type(actual_field.dataType, expected.dataType):
            raise ValueError(f"{name}.{expected.name} expected {expected.dataType}, got {actual_field.dataType}")


def _validate_runtime_metadata(actual, expected, *, path):
    descriptor = actual.metadata.get(METADATA_KEY)
    if descriptor is None:
        return
    expected_descriptor = expected.metadata.get(METADATA_KEY)
    if expected_descriptor is None:
        raise ValueError(f"{path} carries unexpected {METADATA_KEY} metadata")
    if not isinstance(descriptor, Mapping) or descriptor.get("version") != 1:
        version = descriptor.get("version") if isinstance(descriptor, Mapping) else None
        raise ValueError(f"{path} has malformed or unsupported {METADATA_KEY} version {version!r}")
    if dict(descriptor) != expected_descriptor:
        raise ValueError(f"{path} declares {dict(descriptor)!r}, expected {expected_descriptor!r}")


def _same_data_type(actual, expected) -> bool:
    if actual == expected:
        return True
    actual_name = actual.__class__.__name__
    expected_name = expected.__class__.__name__
    if actual_name != expected_name:
        return False
    if actual_name == "ArrayType":
        return _same_data_type(actual.elementType, expected.elementType)
    if actual_name == "MapType":
        return _same_data_type(actual.keyType, expected.keyType) and _same_data_type(
            actual.valueType,
            expected.valueType,
        )
    if actual_name == "StructType":
        actual_fields = {field.name: field for field in actual.fields}
        expected_fields = {field.name: field for field in expected.fields}
        if actual_fields.keys() != expected_fields.keys():
            return False
        return all(
            _same_data_type(actual_fields[name].dataType, expected_fields[name].dataType)
            for name in expected_fields
        )
    return False


def project_schema(df, schema):
    columns = []
    for field in schema:
        column = F.col(field.name)
        metadata = field.metadata
        columns.append(column.alias(field.name, metadata=metadata) if metadata else column)
    return df.select(*columns)


class TransformResult:

    def __init__(self, outputs, *, single=False, schema=None, aliases=None, stage_records=None, stage_outputs_enabled=True, stage_names=(), observations=None, unused_observations=(), stage_observations=None, unused_stage_observations=()):
        values = dict(outputs)
        output_aliases = dict(aliases or {})
        if single:
            if len(values) != 1:
                raise ValueError("single-output TransformResult requires exactly one output")
        object.__setattr__(self, '_structure_outputs', MappingProxyType(values))
        object.__setattr__(self, '_structure_output_aliases', MappingProxyType(output_aliases))
        object.__setattr__(self, '_structure_aliases', MappingProxyType(_alias_index(output_aliases)))
        object.__setattr__(self, '_structure_stages', MappingProxyType(_build_stage_results(stage_records or [], stage_observations or {}, unused_stage_observations)))
        object.__setattr__(self, '_structure_observations', MappingProxyType(dict(observations or {})))
        object.__setattr__(self, '_structure_unused_observations', frozenset(unused_observations))
        object.__setattr__(self, '_structure_stage_outputs_enabled', stage_outputs_enabled)
        object.__setattr__(self, '_structure_stage_names', frozenset(stage_names))
        object.__setattr__(self, 'schema', ResultSchemas(schema, aliases=output_aliases))

    @property
    def stages(self):
        return self._structure_stages

    def __getitem__(self, name):
        if name in self._structure_outputs:
            return self._structure_outputs[name]
        return self._structure_outputs[self._structure_aliases.get(name, name)]

    def __iter__(self):
        return iter(self._structure_outputs)

    def __len__(self):
        return len(self._structure_outputs)

    def __getattr__(self, name):
        if name in self._structure_outputs:
            return self._structure_outputs[name]
        if name in self._structure_aliases:
            return self._structure_outputs[self._structure_aliases[name]]
        if name in self._structure_stages:
            return self._structure_stages[name]
        if name in self._structure_observations:
            return self._structure_observations[name]
        if name in self._structure_unused_observations:
            raise AttributeError(f"Observation {name!r} was declared but is unused in this transform specialization.")
        if name in self._structure_stage_names and not self._structure_stage_outputs_enabled:
            raise AttributeError('Stage output access is disabled; set allow_stage_outputs=True to enable it')
        raise AttributeError(name)

    def __setattr__(self, name, value):
        raise AttributeError("TransformResult is read-only")

    def as_dict(self):
        return dict(self._structure_outputs)


class StageResult:

    def __init__(self, outputs, *, schema=None, aliases=None, stages=None, observations=None, unused_observations=()):
        output_aliases = dict(aliases or {})
        object.__setattr__(self, '_structure_outputs', MappingProxyType(dict(outputs)))
        object.__setattr__(self, '_structure_aliases', MappingProxyType(_alias_index(output_aliases)))
        object.__setattr__(self, '_structure_stages', MappingProxyType(dict(stages or {})))
        object.__setattr__(self, '_structure_observations', MappingProxyType(dict(observations or {})))
        object.__setattr__(self, '_structure_unused_observations', frozenset(unused_observations))
        object.__setattr__(self, 'schema', ResultSchemas(schema, aliases=output_aliases))

    @property
    def stages(self):
        return self._structure_stages

    def __getitem__(self, name):
        if name in self._structure_outputs:
            return self._structure_outputs[name]
        return self._structure_outputs[self._structure_aliases.get(name, name)]

    def __iter__(self):
        return iter(self._structure_outputs)

    def __len__(self):
        return len(self._structure_outputs)

    def __getattr__(self, name):
        if name in self._structure_outputs:
            return self._structure_outputs[name]
        if name in self._structure_aliases:
            return self._structure_outputs[self._structure_aliases[name]]
        if name in self._structure_stages:
            return self._structure_stages[name]
        if name in self._structure_observations:
            return self._structure_observations[name]
        if name in self._structure_unused_observations:
            raise AttributeError(f"Observation {name!r} was declared but is unused in this stage.")
        raise AttributeError(name)

    def __setattr__(self, name, value):
        raise AttributeError('StageResult is read-only')

    def as_dict(self):
        return dict(self._structure_outputs)


def _build_stage_results(records, observation_records=None, unused_observation_records=()):
    root = {}

    def new_node():
        return {'outputs': {}, 'schemas': {}, 'aliases': {}, 'stages': {}, 'observations': {}, 'unused_observations': set()}

    for path, value, schema, aliases in records:
        nodes = root
        for stage_name in path[:-1]:
            node = nodes.setdefault(stage_name, new_node())
            nodes = node['stages']
        stage_name = path[-2]
        node = root
        for name in path[:-2]:
            node = node[name]['stages']
        stage = node.setdefault(stage_name, new_node())
        output_name = path[-1]
        stage['outputs'][output_name] = value
        stage['schemas'][output_name] = schema
        if aliases:
            stage['aliases'][output_name] = aliases

    for path, observations in (observation_records or {}).items():
        nodes = root
        stage = None
        for stage_name in path:
            stage = nodes.setdefault(stage_name, new_node())
            nodes = stage['stages']
        stage['observations'].update(observations)
    for path, name in unused_observation_records:
        nodes = root
        stage = None
        for stage_name in path:
            stage = nodes.setdefault(stage_name, new_node())
            nodes = stage['stages']
        stage['unused_observations'].add(name)

    def freeze(nodes):
        return MappingProxyType({
            name: StageResult(
                node['outputs'],
                schema=node['schemas'],
                aliases=node['aliases'],
                stages=freeze(node['stages']),
                observations=node['observations'],
                unused_observations=node['unused_observations'],
            )
            for name, node in nodes.items()
        })

    return freeze(root)


class ResultSchemas(Mapping):

    def __init__(self, schemas=None, *, aliases=None):
        object.__setattr__(self, '_schemas', MappingProxyType(dict(schemas or {})))
        object.__setattr__(self, '_aliases', MappingProxyType(_alias_index(aliases or {})))

    def __getitem__(self, name):
        if name in self._schemas:
            return self._schemas[name]
        return self._schemas[self._aliases.get(name, name)]

    def __iter__(self):
        return iter(self._schemas)

    def __len__(self):
        return len(self._schemas)

    def __getattr__(self, name):
        if name in self._schemas:
            return self._schemas[name]
        if name in self._aliases:
            return self._schemas[self._aliases[name]]
        raise AttributeError(name)

    def __setattr__(self, name, value):
        raise AttributeError("ResultSchemas is read-only")

    def as_dict(self):
        return dict(self._schemas)


def _alias_index(aliases):
    indexed = {}
    for name, names in aliases.items():
        for alias in names:
            existing = indexed.get(alias)
            if existing is not None and existing != name:
                raise ValueError(f"Result alias {alias} points to both {existing} and {name}")
            indexed[alias] = name
    return indexed
