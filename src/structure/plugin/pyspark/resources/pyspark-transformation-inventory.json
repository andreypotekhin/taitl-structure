    {"id": "functions.map-generators", "family": "SQL functions", "pyspark": ["explode", "explode_outer", "posexplode", "posexplode_outer"]},
    {"id": "dataframe.projection", "family": "DataFrame", "pyspark": ["select", "selectExpr", "withColumn", "withColumns", "withColumnRenamed", "drop", "filter", "where"]},
