{
  "baseline": {
    "pyspark": ">=3.5,<4.1",
    "policy": "Intersection of public PySpark 3.5.x and 4.0.x transformation APIs selected for Structure's typed DSL, plus explicit caller-owned boundary APIs needed for migration disposition.",
    "source": "https://spark.apache.org/docs/4.0.1/api/python/reference/pyspark.sql/",
    "comparison_sources": [
      "https://spark.apache.org/docs/3.5.6/api/python/reference/pyspark.sql/functions.html",
      "https://spark.apache.org/docs/4.0.0/api/python/reference/pyspark.sql/functions.html"
    ]
  },
  "excluded_categories": [
    "DataFrameReader, DataStreamReader, DataFrameWriter, and DataStreamWriter",
    "SparkSession, catalog, table, and storage management",
    "actions and materializers such as collect, count, first, foreach, toPandas, and rdd",
    "streaming lifecycle operations such as start, awaitTermination, trigger, checkpoint, and outputMode",
    "Python UDF/UDTF registration and arbitrary callback APIs",
    "DataFrameWriterV2 partition transforms are inventoried as caller-owned output-layout APIs, not admitted row transformations"
  ],
  "excluded_function_exports": [
    {"id":"raw-expression-escape-hatches","pyspark":["call_function","expr"],"reason":"These accept SQL function names or SQL text outside the compiler-visible typed expression boundary; callers retain native PySpark ownership."},
    {"id":"dynamic-column-and-struct-builders","pyspark":["col","column","struct"],"reason":"Dynamic column-name resolution and schema-inferred struct construction are caller-owned; Structure uses declared Schema fields and explicit typed outputs."},
    {"id":"python-function-extensions","pyspark":["call_udf","pandas_udf","udf","udtf","unwrap_udt"],"reason":"Python callbacks, user-registered functions, UDTFs, and opaque UDT unwrapping require caller-owned runtime/schema contracts."},
    {"id":"session-and-runtime-metadata","pyspark":["current_catalog","current_database","current_schema","current_user","user","version"],"reason":"These observe session identity or runtime state rather than a portable row-local contract; use native PySpark at the session boundary."},
    {"id":"physical-execution-metadata","pyspark":["input_file_block_length","input_file_block_start","input_file_name","monotonically_increasing_id","spark_partition_id"],"reason":"These expose physical file, partition, or execution-plan details and are caller-owned deployment-specific operations."},
    {"id":"runtime-reflection","pyspark":["java_method","reflect","typeof"],"reason":"Reflection and runtime type inspection cannot provide a stable compiler-visible result contract; use native PySpark where required."}
  ],
  "target_only_function_exports": [
    {"version":"3.5.6","pyspark":["approxCountDistinct","countDistinct","sumDistinct","toDegrees","toRadians"],"reason":"Deprecated camel-case or compatibility aliases with snake-case equivalents in the shared baseline; migrate to the listed equivalent in the per-function gap register."},
    {"version":"4.0.0","pyspark":["collate","collation","dayname","from_xml","is_valid_utf8","listagg","listagg_distinct","make_valid_utf8","monthname","nullifzero","randstr","schema_of_xml","session_user","string_agg","string_agg_distinct","timestamp_add","timestamp_diff","to_xml","try_make_interval","try_make_timestamp","try_make_timestamp_ltz","try_make_timestamp_ntz","try_mod","try_parse_url","try_reflect","try_validate_utf8","uniform","validate_utf8"],"reason":"Target-line additions remain gated from the shared >=3.5,<4.1 baseline; per-function target and migration dispositions are in the gap register."}
  ],
  "target_only_apis": [
    {"id":"column.transform","version":"4.1.0","profile":"ordinary PySpark and Spark Connect >=4.1,<4.2","reason":"The typed Column.transform callback is admitted for both PySpark 4.1 variants after online/generated parity; it remains outside the shared 3.5/4.0 transformation baseline and its v8 streaming parity measurement."}
  ],
  "source_modules": [
    {"name":"partitioning","version":"4.0.0","members":["years","months","days","hours","bucket"],"reason":"A namespace export, not a scalar SQL function; the writer partition transforms are separately inventoried as caller-owned output-layout APIs."}
  ],
  "structure_extensions": [
    {"name": "variant_literal", "reason": "Structure-only typed constructor; it is not a PySpark SQL function or TVF and is excluded from the baseline PySpark function census."}
  ],
