{
  "baseline": {
    "pyspark": ">=3.5,<4.1",
    "policy": "Intersection of the public PySpark 3.5.x and 4.0.x transformation APIs selected for Structure's typed DSL.",
    "source": "https://spark.apache.org/docs/4.0.1/api/python/reference/pyspark.sql/"
  },
  "excluded_categories": [
    "DataFrameReader, DataStreamReader, DataFrameWriter, and DataStreamWriter",
    "SparkSession, catalog, table, and storage management",
    "actions and materializers such as collect, count, first, foreach, toPandas, and rdd",
    "streaming lifecycle operations such as start, awaitTermination, trigger, checkpoint, and outputMode",
    "Python UDF/UDTF registration and arbitrary callback APIs"
  ],
  "apis": [
    {"id": "column.comparison", "family": "Column", "pyspark": ["__eq__", "eqNullSafe", "__ne__", "__lt__", "__le__", "__gt__", "__ge__", "between", "isin"]},
    {"id": "column.boolean", "family": "Column", "pyspark": ["__and__", "__or__", "__invert__", "isNull", "isNotNull", "isNaN"]},
