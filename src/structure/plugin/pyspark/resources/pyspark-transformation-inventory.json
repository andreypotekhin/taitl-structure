    {"id": "functions.aggregate-advanced", "family": "SQL functions", "pyspark": ["count_distinct", "count_if", "approx_count_distinct", "approx_percentile", "median", "percentile", "stddev", "stddev_pop", "stddev_samp", "variance", "var_pop", "var_samp", "corr", "covar_samp", "skewness", "kurtosis", "mode"]},
    {"id": "functions.window", "family": "SQL functions", "pyspark": ["row_number", "rank", "dense_rank", "percent_rank", "cume_dist", "ntile", "lag", "lead", "first_value", "last_value", "nth_value"]},
