    {"id": "column.string-predicates", "family": "Column", "pyspark": ["contains", "startswith", "endswith", "like", "ilike", "rlike"]},
    {"id": "column.cast", "family": "Column", "pyspark": ["cast", "try_cast", "astype"]},
    {"id": "column.nested-access", "family": "Column", "pyspark": ["getField", "getItem", "__getitem__"]},
    {"id": "column.struct-mutation", "family": "Column", "pyspark": ["withField", "dropFields"]},
    {"id": "column.sort", "family": "Column", "pyspark": ["asc", "desc", "asc_nulls_first", "asc_nulls_last", "desc_nulls_first", "desc_nulls_last"]},
    {"id": "column.alias", "family": "Column", "pyspark": ["alias", "name"]},
